# rag-svc configuration. Copy to `.env` and edit.
#
# - Defaults that are safe for local dev (compose) are filled in.
# - Anything sensitive or deployment-specific is left as CHANGEME.
# - Compose sources these into the rag-svc container via the environment
#   block in deploy/compose/docker-compose.yml, which hard-codes the
#   service-to-service URLs. This .env is for running the binary outside
#   compose (e.g., `make run` against a local or remote Postgres).

# ---------- Core ----------
# For local dev against docker compose:
DATABASE_URL=postgres://ragsvc:ragsvc@localhost:5432/ragsvc?sslmode=disable
# Alternative: an existing managed/LAN Postgres. Fill in your own creds.
# DATABASE_URL=postgres://USER:PASS@HOST:5432/DB?sslmode=disable
# Redis/Valkey — two modes.
#   standalone: single REDIS_URL (compose, local dev).
#   sentinel:   HA via sentinels list + master name (K8s Valkey-Sentinel).
REDIS_MODE=standalone
REDIS_URL=redis://localhost:6379/0
# Used when REDIS_MODE=sentinel. Ignored in standalone mode.
# REDIS_SENTINELS=valkey-sentinel.cnpg.svc.cluster.local:26379
# REDIS_MASTER_NAME=mymaster
# REDIS_PASSWORD=CHANGEME
# REDIS_SENTINEL_PASSWORD=CHANGEME
BLOB_ENDPOINT=http://localhost:9000
BLOB_BUCKET=rag-svc
BLOB_ACCESS_KEY=minioadmin
BLOB_SECRET_KEY=minioadmin
HTTP_ADDR=:8080
LOG_LEVEL=info

# ---------- LLM providers (OpenAI-compatible) ----------
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=CHANGEME
EMBED_MODEL=text-embedding-3-small
EMBED_BATCH_SIZE=96
ANSWER_BASE_URL=https://api.openai.com/v1
ANSWER_API_KEY=CHANGEME
ANSWER_MODEL=gpt-4.1-mini

# ---------- Jira (Treetop Atlassian Cloud) ----------
JIRA_BASE_URL=https://treetopllc.jira.com
JIRA_EMAIL=CHANGEME@treetopllc.com
JIRA_TOKEN=CHANGEME
# Comma-separated project keys. Empty = ingest all projects visible to the service account.
JIRA_PROJECTS=
JIRA_POLL_INTERVAL=5m
JIRA_REQUEST_TIMEOUT=30s
JIRA_WORKERS=4

# ---------- Confluence (Treetop Atlassian Cloud) ----------
CONFLUENCE_BASE_URL=https://treetopllc.jira.com/wiki
CONFLUENCE_EMAIL=CHANGEME@treetopllc.com
CONFLUENCE_TOKEN=CHANGEME
# Comma-separated space keys. Empty = ingest all spaces visible to the service account.
CONFLUENCE_SPACES=
CONFLUENCE_POLL_INTERVAL=10m
CONFLUENCE_WORKERS=4

# ---------- Auth ----------
OIDC_ISSUER=CHANGEME
OIDC_CLIENT_ID=CHANGEME
OIDC_CLIENT_SECRET=CHANGEME
OIDC_REDIRECT_URL=https://rag.treetopllc.com/auth/callback
OIDC_SESSION_COOKIE=rag_svc_session
SLACK_SIGNING_SECRET=CHANGEME
SLACK_BOT_TOKEN=CHANGEME
# Chrome extension ID (32 chars) for CORS allow-list. Generated when the
# extension is loaded unpacked or published to the Web Store.
EXTENSION_ID=CHANGEME
# Web UI origin added to CORS allow-list. Empty is safe for local-only dev
# (same-origin curl works without CORS).
# WEB_UI_ORIGIN=https://rag.treetopllc.com

# ---------- Search tuning ----------
SEARCH_VECTOR_WEIGHT=0.6
SEARCH_FTS_WEIGHT=0.4
SEARCH_RECENCY_DECAY_DAYS=180
SEARCH_QUERY_CACHE_TTL=300s
SEARCH_RATE_LIMIT_PER_USER=30
